<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="edu.sm.molshop3.repository.ReviewRepository">

    <!-- 특정 상품에 달린 리뷰 목록 조회 -->
    <select id="findByProductId" parameterType="int" resultType="edu.sm.molshop3.dto.Review">
        SELECT * FROM review
        WHERE product_id = #{productId}
        ORDER BY reg_date DESC
    </select>

    <!-- 리뷰 등록 -->
    <insert id="insertReview" parameterType="edu.sm.molshop3.dto.Review">
        INSERT INTO review (score, content, cust_id, order_id, product_id)
        VALUES (#{score}, #{content}, #{custId}, #{orderId}, #{productId})
    </insert>

    <!-- 리뷰 단건 조회 (삭제 권한 확인용) -->
    <select id="selectReview" parameterType="int" resultType="edu.sm.molshop3.dto.Review">
        SELECT * FROM review
        WHERE review_id = #{reviewId}
    </select>

    <!-- 리뷰 삭제 -->
    <delete id="deleteReview" parameterType="int">
        DELETE FROM review
        WHERE review_id = #{reviewId}
    </delete>

</mapper>
