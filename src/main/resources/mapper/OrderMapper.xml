<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="edu.sm.molshop3.repository.OrderRepository">

    <!-- ✅ 주문 등록 -->
    <insert id="insert" parameterType="edu.sm.molshop3.dto.Order"
            useGeneratedKeys="true" keyProperty="orderId">
        INSERT INTO orders (order_date, cust_id)
        VALUES (NOW(), #{custId})
    </insert>

    <!-- ✅ 주문 단건 조회 -->
    <select id="select" parameterType="int" resultType="edu.sm.molshop3.dto.Order">
        SELECT * FROM orders WHERE order_id = #{orderId}
    </select>

    <!-- ✅ 고객의 모든 주문 내역 조회 -->
    <select id="selectByCustId" parameterType="string" resultType="edu.sm.molshop3.dto.Order">
        SELECT * FROM orders
        WHERE cust_id = #{custId}
        ORDER BY order_date DESC
    </select>

</mapper>
