<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="edu.sm.molshop3.repository.ItemRepository">

    <select id="selectByProductId" parameterType="int" resultType="edu.sm.molshop3.dto.Item">
        SELECT *
        FROM item
        WHERE product_id = #{productId}
    </select>

</mapper>
