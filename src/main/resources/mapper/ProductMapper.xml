<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="edu.sm.molshop3.repository.ProductRepository">

    <!-- 기본 Product 매핑 -->
    <resultMap id="ProductMap" type="edu.sm.molshop3.dto.Product">
        <id property="productId" column="product_id"/>
        <result property="productName" column="product_name"/>
        <result property="productPrice" column="product_price"/>
        <result property="cateId" column="cate_id"/>
        <result property="regDate" column="reg_date"/>
        <result property="updateDate" column="update_date"/>
    </resultMap>

    <!-- Product + ProductImage (1:N) 매핑 -->
    <resultMap id="ProductWithImagesMap" type="edu.sm.molshop3.dto.Product">
        <id property="productId" column="product_id"/>
        <result property="productName" column="product_name"/>
        <result property="productPrice" column="product_price"/>
        <result property="cateId" column="cate_id"/>
        <result property="regDate" column="reg_date"/>
        <result property="updateDate" column="update_date"/>

        <collection property="images" ofType="edu.sm.molshop3.dto.ProductImage">
            <id property="productImgId" column="product_img_id"/>
            <result property="productImgUrl" column="product_img_url"/>
            <result property="productId" column="product_id"/>
        </collection>
    </resultMap>

    <!-- 상품 전체 조회 -->
    <select id="selectAll" resultMap="ProductMap">
        SELECT * FROM product
    </select>

    <!-- 상품 단건 조회 -->
    <select id="select" parameterType="int" resultMap="ProductMap">
        SELECT * FROM product WHERE product_id = #{productId}
    </select>

    <!-- 상품 등록 -->
    <insert id="insert" parameterType="edu.sm.molshop3.dto.Product" useGeneratedKeys="true" keyProperty="productId">
        INSERT INTO product (product_name, product_price, cate_id)
        VALUES (#{productName}, #{productPrice}, #{cateId})
    </insert>

    <!-- 상품 수정 -->
    <update id="update" parameterType="edu.sm.molshop3.dto.Product">
        UPDATE product
        SET product_name = #{productName},
            product_price = #{productPrice},
            cate_id = #{cateId},
            update_date = CURRENT_TIMESTAMP
        WHERE product_id = #{productId}
    </update>

    <!-- 상품 삭제 -->
    <delete id="delete" parameterType="int">
        DELETE FROM product WHERE product_id = #{productId}
    </delete>

    <!-- 상품 + 이미지 리스트 전체 조회 -->
    <select id="selectAllWithImages" resultMap="ProductWithImagesMap">
        SELECT p.*, pi.product_img_id, pi.product_img_url
        FROM product p
                 LEFT JOIN productimg pi ON p.product_id = pi.product_id
    </select>

    <!-- 상품 단건 + 이미지 리스트 조회 -->
    <select id="selectWithImages" parameterType="int" resultMap="ProductWithImagesMap">
        SELECT p.*, pi.product_img_id, pi.product_img_url
        FROM product p
                 LEFT JOIN productimg pi ON p.product_id = pi.product_id
        WHERE p.product_id = #{productId}
    </select>

</mapper>