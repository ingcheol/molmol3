<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="edu.sm.molshop3.repository.PaymentRepository">

    <!-- 결제 등록 -->
    <insert id="insert" parameterType="edu.sm.molshop3.dto.Payment" useGeneratedKeys="true" keyProperty="paymentId">
        INSERT INTO payment (payment_method, payment_status, payment_date, order_id)
        VALUES (#{paymentMethod}, #{paymentStatus}, NOW(), #{orderId})
    </insert>

    <!-- payment_id로 단건 조회 -->
    <select id="select" parameterType="int" resultType="edu.sm.molshop3.dto.Payment">
        SELECT * FROM payment WHERE payment_id = #{paymentId}
    </select>

    <!-- order_id로 결제 조회 -->
    <select id="selectByOrderId" parameterType="int" resultType="edu.sm.molshop3.dto.Payment">
        SELECT * FROM payment WHERE order_id = #{orderId}
    </select>

</mapper>
